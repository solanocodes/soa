//@version=6
// SOA RangeFader v1 — winner of the MNQ intraday tournament (research/mnq-algo).
//
// Two complementary mean-reversion edges, one position at a time, RTH only:
//   Edge A: VWAP stretch fade — price stretched > k*stdev from RTH-anchored
//           VWAP with RSI(3) confirmation; 0.5R breakeven lock.
//   Edge B: Initial-balance edge fade on non-extending days, structure stop,
//           0.5R breakeven lock, 30-bar time stop.
//
// Chart: MNQ (CME), 5-minute bars. Backtester defaults below match the
// research cost model ($0.62/side/contract + 1 tick slippage).
//
// Parity notes vs. the Python engine: the engine simulated fills on 1-minute
// bars with worst-case intrabar ordering; TradingView fills on this chart's
// 5-minute bars, so expect small differences. Enable "Use bar magnifier"
// (Premium) for closer parity.
strategy("SOA RangeFader v1 [MNQ]", overlay=true,
     initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, calc_on_every_tick=false, pyramiding=0)

// ---------------- inputs (tournament-selected params) ----------------
kBand    = input.float(1.5,  "VWAP band stretch (k * stdev)", step=0.1)
tgtFrac  = input.float(0.65, "Edge A target (fraction of VWAP distance)", step=0.05)
beR      = input.float(0.5,  "Breakeven lock trigger (R)", step=0.1)
stopAtr  = input.float(1.2,  "Edge A stop (x ATR14)", step=0.1)
ibExt    = input.float(0.3,  "Edge B max day extension beyond IB (x IB range)", step=0.05)
rsiGate  = input.int(35,     "RSI(3) gate (long below / short above 100-x)")
sessA    = input.session("1030-1430", "Edge A entry window (ET)")
sessB    = input.session("1100-1430", "Edge B entry window (ET)")
MIN_STOP = 4.0
MAX_STOP = 80.0
clamp(x) => math.max(MIN_STOP, math.min(MAX_STOP, x))

// ---------------- session logic ----------------
tz = "America/New_York"
inRTH   = not na(time(timeframe.period, "0930-1600", tz))
newRTH  = inRTH and not inRTH[1]
inWinA  = not na(time(timeframe.period, sessA, tz))
inWinB  = not na(time(timeframe.period, sessB, tz))
inIB    = not na(time(timeframe.period, "0930-1030", tz))
flatNow = not na(time(timeframe.period, "1555-1600", tz))

// ---------------- RTH-anchored VWAP ----------------
var float cumPV = 0.0
var float cumV  = 0.0
if newRTH
    cumPV := 0.0
    cumV  := 0.0
if inRTH
    cumPV += hlc3 * volume
    cumV  += volume
vwapRTH = cumV > 0 ? cumPV / cumV : na

dev  = close - vwapRTH
sdev = ta.stdev(dev, 20)
r3   = ta.rsi(close, 3)
atr  = ta.atr(14)

// ---------------- initial balance + day extremes ----------------
var float ibHi = na
var float ibLo = na
var float dayHi = na
var float dayLo = na
if newRTH
    ibHi := high
    ibLo := low
    dayHi := high
    dayLo := low
if inRTH and not newRTH
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)
    if inIB
        ibHi := math.max(ibHi, high)
        ibLo := math.min(ibLo, low)
ibRange = ibHi - ibLo
ibMid   = (ibHi + ibLo) / 2
notExtended = not na(ibRange) and ibRange > 0 and dayHi <= ibHi + ibExt * ibRange and dayLo >= ibLo - ibExt * ibRange

// ---------------- entries ----------------
distOK = math.abs(dev) >= 0.6 * atr
flat   = strategy.position_size == 0

var float stopPts = na
var float tgtPts  = na
var int   entryBar = na
var string edge = na

// Edge A: VWAP stretch fade
if flat and inWinA and not na(sdev) and sdev > 0 and distOK and barstate.isconfirmed
    if dev < -kBand * sdev and r3 < rsiGate
        stopPts := clamp(stopAtr * atr)
        tgtPts  := clamp(tgtFrac * math.abs(dev))
        edge := "A"
        strategy.entry("A long", strategy.long)
    else if dev > kBand * sdev and r3 > 100 - rsiGate
        stopPts := clamp(stopAtr * atr)
        tgtPts  := clamp(tgtFrac * math.abs(dev))
        edge := "A"
        strategy.entry("A short", strategy.short)

// Edge B: IB edge fade on non-extending days
if flat and inWinB and notExtended and barstate.isconfirmed
    if high >= ibHi and close < ibHi and close < close[1]
        stopPts := clamp(math.max(high, math.max(high[1], high[2])) - close + 2.0)
        tgtPts  := clamp((close - ibMid) * 0.9)
        edge := "B"
        strategy.entry("B short", strategy.short)
    else if low <= ibLo and close > ibLo and close > close[1]
        stopPts := clamp(close - math.min(low, math.min(low[1], low[2])) + 2.0)
        tgtPts  := clamp((ibMid - close) * 0.9)
        edge := "B"
        strategy.entry("B long", strategy.long)

// ---------------- exits: bracket + breakeven lock + time stop ----------------
var bool beLocked = false
if strategy.position_size != 0
    if na(entryBar)
        entryBar := bar_index
        beLocked := false
    avg = strategy.position_avg_price
    long = strategy.position_size > 0
    if not beLocked and beR > 0
        moved = long ? high - avg : avg - low
        if moved >= beR * stopPts
            beLocked := true
    stopPx = beLocked ? avg + (long ? 1 : -1) * syminfo.mintick : avg - (long ? 1 : -1) * stopPts
    tgtPx  = avg + (long ? 1 : -1) * tgtPts
    strategy.exit("x", stop=stopPx, limit=tgtPx)
    if edge == "B" and bar_index - entryBar >= 30
        strategy.close_all(comment="time")
else
    entryBar := na
    beLocked := false

if flatNow or not inRTH
    strategy.close_all(comment="eod")
    strategy.cancel_all()

// ---------------- plots ----------------
plot(vwapRTH, "RTH VWAP", color=color.orange, linewidth=2)
plot(vwapRTH + kBand * sdev, "upper band", color=color.new(color.orange, 60))
plot(vwapRTH - kBand * sdev, "lower band", color=color.new(color.orange, 60))
plot(inRTH ? ibHi : na, "IB high", color=color.new(color.aqua, 40), style=plot.style_linebr)
plot(inRTH ? ibLo : na, "IB low",  color=color.new(color.aqua, 40), style=plot.style_linebr)
